{
  "appId": "ch.gigibeauty.app",
  "appName": "GiGi Beauty",
  "webDir": "www",
  "server": {
    "url": "https://www.gigibeauty.ch/?app=1",
    "allowNavigation": [
      "www.gigibeauty.ch",
      "gigibeauty.ch"
    ],
    "errorPath": "index.html"
  },
  "appendUserAgent": "GiGiBeautyApp",
  "backgroundColor": "#211711",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#211711",
    "appendUserAgent": "GiGiBeautyApp push"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#211711"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
